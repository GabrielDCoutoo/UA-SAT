# Copia para .env (desenvolvimento) ou .env.production (build de produção). NÃO versionados.
# Variáveis VITE_* ficam embebidas no JavaScript enviado ao browser: nunca metas aqui segredos.
# Sem estas variáveis, o frontend usa http://localhost:3000.

# URL do backend (HTTP)
VITE_API_URL=http://localhost:3000
# URL do backend para o WebSocket (Socket.io)
VITE_WS_URL=http://localhost:3000
