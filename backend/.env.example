# =============================================================================
# Ground Station Backend: exemplo de configuração
# Copia para .env (NÃO versionado) e preenche. As linhas com "your-value-here"/"changeme"/"exemplo_*"
# são placeholders. Por omissão, todos os módulos externos estão DESLIGADOS (false): só o
# servidor, o login e (opcionalmente) a base de dados arrancam.
# =============================================================================

# ── 1) Servidor ──────────────────────────────────────────────────────────────
PORT=3000
# Interface onde o Node escuta. Por omissão só 127.0.0.1 (o acesso externo faz-se pelo proxy reverso).
# Usa 0.0.0.0 apenas se precisares de aceder ao backend a partir de outra máquina.
# HOST=127.0.0.1
NODE_ENV=development
# Origem do frontend permitida no WebSocket (Socket.io). Em produção, o URL público do dashboard.
FRONTEND_URL=http://localhost:5173

# Atrás de um proxy reverso (nginx): nº de proxies entre o cliente e o Node (normalmente 1).
# Necessário para o rate limit do login ver o IP real do visitante (senão 5 falhas de qualquer pessoa
# bloqueiam toda a gente). Com o Node exposto diretamente, NÃO definas (o cabeçalho X-Forwarded-For
# passaria a poder ser forjado). Não uses 'true': confiaria em qualquer X-Forwarded-For.
# TRUST_PROXY=1

# ── 2) Segurança ─────────────────────────────────────────────────────────────
# OBRIGATÓRIO. Segredo de assinatura dos tokens JWT: gera um forte com  openssl rand -hex 32
# Deixado vazio de propósito: sem ele o servidor recusa arrancar (nunca uses um valor de exemplo).
JWT_SECRET=
# Utilizadores que podem iniciar sessão no dashboard (só é preciso login para AGENDAR observações
# SatNOGS; o resto é leitura pública). Vazios de propósito: entradas sem valor são ignoradas,
# por isso, enquanto não os definires, ninguém consegue fazer login.
DASHBOARD_USER_1=
DASHBOARD_PASS_1=
DASHBOARD_USER_2=
DASHBOARD_PASS_2=
# Chave da app GNSS (Android): enviada no cabeçalho X-Api-Key em POST /api/gnss/measurement.
# Vazia de propósito: sem ela a rota recusa todos os pedidos (503). Gera uma com: openssl rand -hex 32
GNSS_API_KEY=

# ── 3) PostgreSQL ────────────────────────────────────────────────────────────
# OBRIGATÓRIAS (DB_HOST e DB_PORT têm valor por omissão). Cria uma base de dados vazia; as tabelas
# são criadas/alteradas no arranque (sequelize.sync({ alter: true })). Se a base não estiver
# acessível, o servidor arranca na mesma: os pacotes TinyGS ficam em memória, mas os endpoints de
# UASAT, UAV e GNSS respondem 500.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your-value-here
DB_USER=your-value-here
DB_PASSWORD=changeme

# ── 4) Estação e balão ───────────────────────────────────────────────────────
MY_STATION_ID=UA_Aveiro_GS
MY_STATION_LAT=40.644
MY_STATION_LNG=-8.645
MY_STATION_ALTITUDE=50
BALLOON_NAME=BALAO-UA-01
BALLOON_FREQUENCY=433.0
BALLOON_CALL_SIGN=your-value-here
# Posição usada na previsão de passagens SatNOGS (por omissão no código: Aveiro)
# STATION_LAT=40.644
# STATION_LON=-8.645
# STATION_ALT=50
# STATION_NAME=UA Aveiro

# ── 5) TinyGS ────────────────────────────────────────────────────────────────
ENABLE_TINYGS=false
# Ligação MQTT ao broker do TinyGS
TINYGS_MQTT_ENABLED=false
TINYGS_BROKER=mqtts://mqtt.tinygs.com
TINYGS_PORT=8883
TINYGS_USER_PRIMARY=exemplo_user1
TINYGS_PASS_PRIMARY=exemplo_pass1
# Segunda conta (opcional). Se definida, é a usada na ligação MQTT e pelo Node-RED.
# Se a password tiver o carácter $, põe o valor entre aspas simples.
TINYGS_USER_SECONDARY=exemplo_user2
TINYGS_PASS_SECONDARY=exemplo_pass2
# Tópicos (opcionais; por omissão: tinygs/packets/# e um tópico derivado do utilizador principal)
# MQTT_TOPIC_MY_STATION=
# MQTT_TOPIC_ALL_PUBLIC=tinygs/packets/#
TINYGS_POLL_INTERVAL=15000
# Recolha via browser automatizado (Playwright). Requer: npx playwright install chromium
TINYGS_PLAYWRIGHT_ENABLED=false
TINYGS_PLAYWRIGHT_INTERVAL=30000
# Cliente REST / mapa global TinyGS (opcionais): dados da sessão web do tinygs.com
TINYGS_USER_ID=your-value-here
TINYGS_SESSION_TOKEN=your-value-here

# ── 6) SatNOGS ───────────────────────────────────────────────────────────────
ENABLE_SATNOGS=false
SATNOGS_STATION_ID=4518
# Token da tua conta em network.satnogs.org. Usado SÓ no servidor (agendar observações e listagens autenticadas).
SATNOGS_API_TOKEN=your-value-here
SATNOGS_POLL_INTERVAL=60000
# SATNOGS_BASE_URL=https://network.satnogs.org/api

# ── 7) Telemetria própria (MQTT) ─────────────────────────────────────────────
# UASAT: telemetria LoRa do balão/satélite, recebida por MQTT
ENABLE_UASAT=false
UASAT_MQTT_BROKER=mqtt://localhost:1883
UASAT_MQTT_TOPIC=uasat/telemetry/#
UASAT_MQTT_USER=your-value-here
UASAT_MQTT_PASS=changeme
# UAV backscatter
ENABLE_UAV=false
UAV_MQTT_BROKER=mqtt://localhost:1883
UAV_MQTT_TOPIC=your-value-here
UAV_MQTT_USER=your-value-here
UAV_MQTT_PASS=changeme
# Bridge MQTT (opcional): reencaminha os pacotes para um broker remoto via túnel SSH. Arranca sempre;
# se o destino não existir, falha em silêncio e tenta de novo a cada 10 s.
# MQTT_BRIDGE_HOST=localhost
# MQTT_BRIDGE_PORT=1884
# MQTT_BRIDGE_USER=
# MQTT_BRIDGE_PASS=

# ── 8) Outras fontes ─────────────────────────────────────────────────────────
# ThingSpeak (backup): canal e chave de leitura
# THINGSPEAK_CHANNEL_ID=3236598
THINGSPEAK_READ_API_KEY=your-value-here
# Stream HLS do balão. GET /api/stream/status não verifica o stream: só devolve "live" com STREAM_MOCK=true.
STREAM_HLS_URL=http://localhost:8080/live/balloon/index.m3u8
STREAM_MOCK=false

# ── 9) Testes e limites ──────────────────────────────────────────────────────
# Sem efeito de momento: só é refletida em GET /api/config
MOCK_DATA=false
# Pacotes mantidos em memória (por omissão 100)
# MAX_PACKETS_IN_MEMORY=100

# ── 10) Scripts de teste (mqtt.py, mqtt_simulator.py, scripts/) ──────────────
# Broker MQTT dos simuladores
# (os scripts lêem este .env se python-dotenv estiver instalado; senão, exporta as variáveis no shell)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_USER=your-value-here
MQTT_BROKER_PASS=changeme
# SIM_MQTT_BROKER=mqtt://localhost:1883

# ── 11) Docker Compose (InfluxDB, Grafana, Node-RED) ─────────────────────────
# Define ANTES de `docker compose up -d` (o Compose lê este mesmo ficheiro .env). Usa valores fortes.
# Vazios de propósito: o Compose recusa arrancar sem eles (nunca uses um valor de exemplo).
INFLUXDB_INIT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
